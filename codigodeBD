CREATE TABLE Usuarios (
id_usuario INT PRIMARY KEY,
nombre_usuario VARCHAR(50),
email VARCHAR(100),
contrasena VARCHAR(100),
foto_perfil VARCHAR(255),
fecha_registro DATE
);

CREATE TABLE Prendas (
id_prenda INT PRIMARY KEY,
id_usuario INT,
nombre_prenda VARCHAR(100),
foto VARCHAR(255),
tipo VARCHAR(50),
color VARCHAR(50),
estilo VARCHAR(50),
temporada VARCHAR(50),
FOREIGN KEY (id_usuario) REFERENCES Usuarios(id_usuario)
);


CREATE TABLE Etiquetas (
id_etiqueta INT PRIMARY KEY,
nombre_etiqueta VARCHAR(50)
);

CREATE TABLE Prenda_Etiqueta (
id_prenda_etiqueta INT PRIMARY KEY,
id_prenda INT,
id_etiqueta INT,
FOREIGN KEY (id_prenda) REFERENCES Prendas(id_prenda),
FOREIGN KEY (id_etiqueta) REFERENCES Etiquetas(id_etiqueta)
);

CREATE TABLE Outfits (
id_outfit INT PRIMARY KEY,
id_usuario INT,
nombre_outfit VARCHAR(100),
fecha_creacion DATE,

favorito BOOLEAN,
FOREIGN KEY (id_usuario) REFERENCES Usuarios(id_usuario)
);

CREATE TABLE Outfit_Prenda (
id_outfit_prenda INT PRIMARY KEY,
id_outfit INT,
id_prenda INT,
FOREIGN KEY (id_outfit) REFERENCES Outfits(id_outfit),
FOREIGN KEY (id_prenda) REFERENCES Prendas(id_prenda)
);

CREATE TABLE Colores (
id_color INT PRIMARY KEY,
nombre_color VARCHAR(50),
codigo_hex VARCHAR(7)
);

CREATE TABLE Intereses (
id_interes INT PRIMARY KEY,
nombre_interes VARCHAR(50)
);

CREATE TABLE Usuario_Interes (
id_usuario_interes INT PRIMARY KEY,
id_usuario INT,
id_interes INT,
FOREIGN KEY (id_usuario) REFERENCES Usuarios(id_usuario),
FOREIGN KEY (id_interes) REFERENCES Intereses(id_interes)
);

CREATE TABLE Conversaciones (
id_conversacion INT PRIMARY KEY,
fecha_creacion DATE
);

CREATE TABLE Conversacion_Usuario (

id_conversacion_usuario INT PRIMARY KEY,
id_conversacion INT,
id_usuario INT,
FOREIGN KEY (id_conversacion) REFERENCES Conversaciones(id_conversacion),
FOREIGN KEY (id_usuario) REFERENCES Usuarios(id_usuario)
);

CREATE TABLE Mensajes (
id_mensaje INT PRIMARY KEY,
id_conversacion INT,
id_usuario INT,
contenido TEXT,
fecha_hora DATETIME,
FOREIGN KEY (id_conversacion) REFERENCES Conversaciones(id_conversacion),
FOREIGN KEY (id_usuario) REFERENCES Usuarios(id_usuario)
);
